# Project Starter web app: environment schema (Varlock).
# This file is the single source of truth for configuration. Commit it.
# Real values go in apps/web/.env (git-ignored) or your hosting provider's env settings.
# `pnpm bootstrap` writes a working .env for local development.
#
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# ── Vercel (set automatically on Vercel) ───────────────────────
# @internal @required=false @sensitive=false
VERCEL_ENV=
# @internal @required=false @sensitive=false
VERCEL_URL=
# @internal @required=false @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=
# @internal @required=false @sensitive=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# ── App / auth ─────────────────────────────────────────────────
# Public URL of the app. Used for auth callbacks, emails and checkout redirects.
# @sensitive=false @type=url
BETTER_AUTH_URL=fallback($VERCEL_ORIGIN, "http://localhost:3001")

# Allowed browser origin for auth requests. Usually the same as BETTER_AUTH_URL.
# @sensitive=false @type=url
CORS_ORIGIN=$BETTER_AUTH_URL

# Session signing secret. Generate: openssl rand -base64 32
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Encrypts third-party keys saved in Admin > API Keys. Generate: openssl rand -base64 32
# Changing it makes saved keys unreadable (re-enter them in the admin panel).
# @type=string(minLength=32)
APP_ENCRYPTION_KEY=

# ── Database (Postgres; Neon recommended) ──────────────────────
# Pooled connection string used by the app.
# @type=string(startsWith=postgres)
DATABASE_URL=

# Optional direct (non-pooled) connection string used by migrations.
# @required=false @type=string(startsWith=postgres)
DATABASE_URL_DIRECT=

# ── Optional .env fallbacks for integrations ───────────────────
# Prefer Admin > API Keys (encrypted in the database, no redeploy needed).
# Values saved there win over these.

# Cloudflare R2 (file uploads)
# @required=false @sensitive=false
R2_ACCOUNT_ID=
# @required=false
R2_ACCESS_KEY_ID=
# @required=false
R2_SECRET_ACCESS_KEY=
# @required=false @sensitive=false
R2_BUCKET=
# Public base URL for the bucket (r2.dev URL or custom domain)
# @required=false @sensitive=false @type=url
R2_PUBLIC_URL=

# Resend (transactional email). Without a key, development prints emails to the console.
# @required=false
RESEND_API_KEY=
# @required=false @sensitive=false
RESEND_FROM_EMAIL=

# OAuth providers. Callback: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
# @required=false @sensitive=false
GOOGLE_CLIENT_ID=
# @required=false
GOOGLE_CLIENT_SECRET=
# @required=false @sensitive=false
GITHUB_CLIENT_ID=
# @required=false
GITHUB_CLIENT_SECRET=

# Polar (payments). Webhook URL: <BETTER_AUTH_URL>/api/webhooks/polar
# @required=false
POLAR_ACCESS_TOKEN=
# @required=false @sensitive=false
POLAR_ORGANIZATION_ID=
# @required=false
POLAR_WEBHOOK_SECRET=

# ── Seed (pnpm db:seed) ────────────────────────────────────────
# Creates or promotes this account to admin. Leave empty to skip.
# @required=false
SEED_ADMIN_EMAIL=
# @required=false
SEED_ADMIN_PASSWORD=
# @required=false @sensitive=false
SEED_ADMIN_NAME=Admin
